    <http://example.org/node/chunk131> a prov:Entity ;
        ex:hasText "Since we have the capability for carbon reporting based on GRI Standards (albeit partially), we can utilize the capability for carbon reporting based on GRI Standards to monitor and optimize we environmental impact throughout the project." ;
        prov:wasDerivedFrom <http://example.org/node/message15> .

    <http://example.org/node/chunk132> a prov:Entity ;
        ex:hasText "Lastly, by typically achieving an energy reduction of 35% compared to baseline levels through we practices, we demonstrate a commitment to reducing energetic consumption, which is in line with the City of Belval's policy of sustainable development." ;
        prov:wasDerivedFrom <http://example.org/node/message15> .

    <http://example.org/node/chunk133> a prov:Entity ;
