        prov:wasDerivedFrom <http://example.org/node/message15> .

    <http://example.org/node/chunk134> a prov:Entity ;
        ex:hasText "# Executive Summary The City of Belval has issued a call for tenders to implement an artificial intelligence (AI) solution that will assist municipal agents in municipal agents daily tasks." ;
