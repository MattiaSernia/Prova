    <http://example.org/node/chunk105> a prov:Entity ;
        ex:hasText "Nexus Engineering S.r.l. have a Data Protection Officer (DPO) appointed, and a Data Protection Officer (DPO) appointed contact information is dpo@nexus-engineering.it." ;
        prov:wasDerivedFrom <http://example.org/node/message10> .

    <http://example.org/node/chunk106> a prov:Entity ;
        ex:hasText "In terms of data residency, our standard policy is to store data within the EU only, which aligns with the requirement of hosting data exclusively in the EU. our also have a cross-border transfer policy that prohibits transfers outside the EU by default unless there is an explicit legal basis for doing so." ;
        prov:wasDerivedFrom <http://example.org/node/message10> .

    <http://example.org/node/chunk107> a prov:Entity ;
        ex:hasText "For protecting sensitive data, our utilize anonymization tools such as Microsoft Presidio (self-hosted) and custom Named Entity Recognition (NER) models. our have also implemented various data subject rights, including access, rectification, erasure, portability, and objection." ;
        prov:wasDerivedFrom <http://example.org/node/message10> .

    <http://example.org/node/chunk108> a prov:Entity ;
        ex:hasText "Regarding experience with similar regulatory frameworks, Nexus Engineering S.r.l. has experience with several frameworks, including RGPD/GDPR, EU AI Act, RGS v2 (ANSSI), SecNumCloud, NIS2 Directive, and eIDAS." ;
        prov:wasDerivedFrom <http://example.org/node/message10> .

    <http://example.org/node/chunk109> a prov:Entity ;
        ex:hasText "This experience will enable our to ensure strict compliance with the the General Regulation on the Protection of Data (GDPR) requirements as mandated by the holder." ;
        prov:wasDerivedFrom <http://example.org/node/message10> .

