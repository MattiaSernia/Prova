        prov:wasDerivedFrom <http://example.org/node/message18> .

    <http://example.org/node/chunk144> a prov:Entity ;
        ex:hasText "Nexus Engineering S.r.l. have already published Nexus Engineering S.r.l." ;
        prov:wasDerivedFrom <http://example.org/node/message18> .

    <http://example.org/node/chunk145> a prov:Entity ;
        ex:hasText "CSR policy and have conducted a Bilan Carbone in 2023, which assessed Nexus Engineering S.r.l. total Scope 1 and 2 emissions at 148 tCO2e." ;
        prov:wasDerivedFrom <http://example.org/node/message18> .

    <http://example.org/node/chunk146> a prov:Entity ;
        ex:hasText "Nexus Engineering S.r.l. goal is to reach net zero by 2040." ;
        prov:wasDerivedFrom <http://example.org/node/message18> .

    <http://example.org/node/chunk147> a prov:Entity ;
        ex:hasText "To address The City of Belval requirements, Nexus Engineering S.r.l. can propose several solutions that align with Nexus Engineering S.r.l. environmental capabilities." ;
        prov:wasDerivedFrom <http://example.org/node/message18> .

    <http://example.org/node/chunk148> a prov:Entity ;
        ex:hasText "Firstly, Nexus Engineering S.r.l. have partnerships with green hosting providers, such as OVHcloud and Scaleway, both based in France and using 100% renewable energy. green hosting providers, such as OVHcloud and Scaleway, both based in France and using 100% renewable energy Power Usage Effectiveness (PUE) is also relatively low, at 1.3 and 1.28 respectively." ;
        prov:wasDerivedFrom <http://example.org/node/message18> .

    <http://example.org/node/chunk149> a prov:Entity ;
        ex:hasText "Additionally, Nexus Engineering S.r.l. implement digital sobriety practices that reduce energy consumption." ;
        prov:wasDerivedFrom <http://example.org/node/message18> .

    <http://example.org/node/chunk15> a prov:Entity ;
        ex:hasText "Technical constraints 5.1 Performance The expected solution will have to provide times of response compatible with a daily use by the agents." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk150> a prov:Entity ;
