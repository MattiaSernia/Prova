<http://example.org/extraction/req/extraction1> {
    req:req1 a ex:Requirement ;
        ns1:improve <http://example.org/node/efficiency_of_administrative_services> ;
        ex:category ex:public_administration ;
        rdf:subject <http://example.org/node/city_of_belval> .

    req:req2 a ex:Requirement ;
        ns1:improve <http://example.org/node/quality_of_service_rendered_to_users> ;
        ex:category ex:public_administration ;
        rdf:subject <http://example.org/node/city_of_belval> .

    req:req3 a ex:Requirement ;
        ns1:facilitate <http://example.org/node/access_to_information> ;
        ex:category ex:public_administration ;
        rdf:subject <http://example.org/node/agents> .

    req:req4 a ex:Requirement ;
        ns1:improve <http://example.org/node/quality_of_answers> ;
        ex:category ex:public_administration ;
        rdf:subject <http://example.org/node/agents> .

    req:req5 a ex:Requirement ;
        ns1:reduce <http://example.org/node/times_of_processing> ;
        ex:category ex:public_administration ;
