        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro2 a ex:Proposal ;
        ns1:will_utilize <http://example.org/node/containerization_tools_like_docker_kubernetes_k8s_and_helm_to_ensure_high_availability_and_scalability> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro3 a ex:Proposal ;
        ns1:will_optimize <http://example.org/node/llm_models_including_mistral_7b_llama_3_8b_camembert_and_falcon_7b_using_quantisation_methods_like_int8_or_int4_gptq_to_achieve_a_response_time_of_less_than_2_seconds> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro4 a ex:Proposal ;
        ns1:will_integrate <http://example.org/node/the_proposed_solution_with_the_client_s_existing_systems_including_civil_status_and_town_planning_software_edm_and_user_directories_using_api_standards_like_rest_graphql_and_soap> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro5 a ex:Proposal ;
        ns1:proposes <http://example.org/node/leveraging_rag_capabilities_including_dense_vector_semantic_search_bm25_sparse_search_and_hybrid_search_to_provide_relevant_information_to_municipal_agents> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro6 a ex:Proposal ;
        ns1:will_utilize <http://example.org/node/experience_with_vector_stores_like_qdrant_weaviate_pgvector_and_faiss_to_enhance_the_search_functionality> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro7 a ex:Proposal ;
        ns1:will_guarantee <http://example.org/node/eu_only_hosting_prohibit_data_transfers_outside_eu_by_default_and_protect_sensitive_data_through_appropriate_anonymization_tools_like_microsoft_presidio> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro8 a ex:Proposal ;
        ns1:confirms <http://example.org/node/that_data_residency_is_eu_only_and_have_a_cross_border_transfer_policy_that_prohibits_transfers_outside_eu> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro9 a ex:Proposal ;
        ns1:estimates <http://example.org/node/an_annual_cost_of_approximately_750_000_euros_over_4_years_with_a_total_contract_value_of_3_million_euros> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .
}

