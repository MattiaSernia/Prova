    <http://example.org/node/chunk81> a prov:Entity ;
        ex:hasText "Overall, our current technology stack can meet the requirements of integrating with existing systems, hosting on SecNumCloud-type infrastructure, and minimizing dependence on non-European suppliers." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk82> a prov:Entity ;
        ex:hasText "The tender requires strict GDPR compliance, including data hosting exclusively in the EU, no data transfer outside the EU, and protection of sensitive data through encryption or anonymization." ;
