        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk67> a prov:Entity ;
        ex:hasText "Thirdly, Nexus Engineering S.r.l. will integrate the new AI solution with existing practices and systems, minimizing disruption to municipal agents workflows." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk68> a prov:Entity ;
        ex:hasText "Nexus Engineering S.r.l. experience with Agile Scrum and SAFe methodologies will enable Nexus Engineering S.r.l. to deliver a flexible and adaptive solution." ;
