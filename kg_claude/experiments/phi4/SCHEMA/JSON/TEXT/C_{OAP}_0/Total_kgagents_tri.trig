    <http://example.org/node/chunk89> a prov:Entity ;
        ex:hasText "Additionally, Nexus Engineering S.r.l. will ensure that no personal data is permitted in training pipelines for AI solutions, adhering to Nexus Engineering S.r.l. internal constraint of anonymization being mandatory before any model update." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk9> a prov:Entity ;
        ex:hasText "The generated contents will have to be adapted to the administrative context and compliant with the requirements of quality expected. 3.3 Assistance with the instruction of files The expected solution will have to be in measure to assist the agents in the analysis and the processing of files, by: proposing relevant information, recalling the applicable rules, suggesting actions or verifications to carry out." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk90> a prov:Entity ;
        ex:hasText "This practice aligns with the GDPR principle of data protection by design and default." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk91> a prov:Entity ;
        ex:hasText "To prevent unauthorized access or transfer, Nexus Engineering S.r.l. will enforce strict access controls, including multi-factor authentication (MFA) using TOTP or hardware tokens (FIDO2), role-based access control (RBAC), and privileged access management solutions like CyberArk Conjur or HashiCorp Vault." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk92> a prov:Entity ;
        ex:hasText "These measures are designed to limit who can access the data and under what circumstances, further enhancing GDPR compliance." ;
