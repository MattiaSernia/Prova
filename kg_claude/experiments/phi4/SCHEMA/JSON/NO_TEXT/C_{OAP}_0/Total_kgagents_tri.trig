        prov:wasDerivedFrom <http://example.org/node/message15> .

    <http://example.org/node/chunk128> a prov:Entity ;
        ex:hasText "To reduce our company's carbon footprint, our company's have implemented various digital sobriety practices such as INT8/INT4 model quantisation, auto-scaling to zero outside business hours, query result caching, and a green IT hardware procurement policy with a minimum 5-year lifecycle." ;
        prov:wasDerivedFrom <http://example.org/node/message15> .

    <http://example.org/node/chunk129> a prov:Entity ;
        ex:hasText "These practices have resulted in a typical energy reduction of 35% compared to our company's baseline. our company's green hosting partners, OVHcloud and Scaleway, both located in France, use 100% renewable energy and have ISO14001 certification." ;
