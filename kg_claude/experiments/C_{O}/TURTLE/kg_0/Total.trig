    <http://example.org/node/chunk59> a prov:Entity ;
        ex:hasText "The City of Belval is looking for an artificial intelligence solution to assist The City of Belval agents in its agents daily missions. an artificial intelligence solution to assist its agents in their daily missions has a duration of 4 years and a global budget of 3 million euros." ;
