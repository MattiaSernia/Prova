    <http://example.org/node/chunk145> a prov:Entity ;
        ex:hasText "Given the reference budget of €900,000 over 5 years, the authority's aim to maintain our pricing model integrity while ensuring cost control." ;
        prov:wasDerivedFrom <http://example.org/node/message11> .

    <http://example.org/node/chunk146> a prov:Entity ;
        ex:hasText "To achieve maintain, the authority's will work with the architect to select a configuration that keeps costs within the authority's budget envelope while preserving an acceptable margin." ;
