    <http://example.org/node/chunk127> a prov:Entity ;
        ex:hasText "The solution system also supports pseudonymisation, data minimisation, and configurable retention, ensuring the protection of sensitive data." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk128> a prov:Entity ;
