    <http://example.org/node/chunk124> a prov:Entity ;
        ex:hasText "The solution already hold the ISO 27001 certification since 2023, which covers development, delivery, and operations, as well as the ISO 27701 certification for privacy information management." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk125> a prov:Entity ;
        ex:hasText "Additionally, The solution have the French Hébergeur de Données de Santé (HDS) certification through The solution hosting infrastructure operated on OuraneCloud, a SecNumCloud-qualified sovereign cloud, ensuring compliance with French health data hosting regulations." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk126> a prov:Entity ;
        ex:hasText "For GDPR compliance, The solution can utilize The solution existing data protection measures, including encryption in transit using TLS 1.3 and encryption at rest using AES-256, both of which are managed through The solution the European Union-based infrastructure." ;
