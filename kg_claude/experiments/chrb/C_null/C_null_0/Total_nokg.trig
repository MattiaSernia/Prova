    <http://example.org/node/chunk120> a prov:Entity ;
        ex:hasText "The tender requires strict GDPR compliance, including exclusive hosting within the European Union, no transfer of data outside the European Union, encryption, and pseudonymisation of sensitive data where relevant." ;
