        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk115> a prov:Entity ;
        ex:hasText "The platform containerization using Kubernetes will enable horizontal scaling to handle increased throughput while maintaining response times below 2 seconds for common queries." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk116> a prov:Entity ;
        ex:hasText "For health interoperability, our will utilize our FHIR_HL7 connector, which supports production for main resources and has extended resource coverage on the roadmap. our partnership with Ligeo Santé as a delivery partner will facilitate alignment with the Ségur / Mon espace santé–DMP framework." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk117> a prov:Entity ;
        ex:hasText "Data sovereignty will be ensured by hosting The expected solution on the Sovereign HDS tier, which is EU-only and powered by renewable energy." ;
