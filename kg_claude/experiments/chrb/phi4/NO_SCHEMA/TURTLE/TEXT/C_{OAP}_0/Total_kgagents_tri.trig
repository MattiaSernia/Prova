    <http://example.org/node/chunk1> a prov:Entity ;
        ex:hasText "Public Tender - Centre Hospitalier Régional de Belval (CHRB) Implementation of an AI assistance solution for hospital staff 1." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk10> a prov:Entity ;
        ex:hasText "The solution must let staff quickly access reliable, up-to-date information drawn from the authority's internal procedures, care protocols and HAS recommendations, applicable regulatory texts, and internal documents (guides, notes, reference frameworks, drug references)." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk100> a prov:Entity ;
        ex:hasText "By consolidating our consortium's contributions, including our consortium's expertise in AI assistance, data protection, and digital transformation, we can submit a comprehensive tender response that addresses all aspects of the project while meeting the client's requirements and constraints. we team is ready to collaborate with the client to ensure a successful project outcome that improves staff efficiency, patient care quality, and contributes to environmental sustainability." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk101> a prov:Entity ;
        ex:hasText "The client requires an AI solution with a response time below 2 seconds for common queries, high answer relevance, integration with the hospital information system (SIH) and electronic patient record (DPI), support for health interoperability standards (HL7/FHIR), and API-type interfaces." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk102> a prov:Entity ;
