    <http://example.org/node/chunk143> a prov:Entity ;
        ex:hasText "The solution must provide drafting assistance, support medical coding (PMSI, ICD-10) for activity reporting (T2A), and facilitate access to information." ;
        prov:wasDerivedFrom <http://example.org/node/message13> .

    <http://example.org/node/chunk144> a prov:Entity ;
