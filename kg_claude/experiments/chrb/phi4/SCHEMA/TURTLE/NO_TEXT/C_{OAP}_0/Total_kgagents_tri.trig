    <http://example.org/node/chunk13> a prov:Entity ;
        ex:hasText "Generated content must be adapted to the clinical/administrative context and conform to expected quality standards. 3.3 Dossier-handling assistance." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk130> a prov:Entity ;
        ex:hasText "In terms of compliance with relevant regulatory frameworks, we can confirm that we platform IP model is based on proprietary software owned by we, licensed to clients under a subscription/usage model. we open-source components are licensed under permissive licenses, and we provide an SBOM (Software Bill of Materials) to clients. we also ensure that client data ownership is respected, with a reversibility plan in place for the return and deletion of client data at the end of the contract." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk131> a prov:Entity ;
