    <http://example.org/node/chunk132> a prov:Entity ;
        ex:hasText "Additionally, we must review we contractual terms to ensure our contractual terms align with the client's expectations regarding data sovereignty, GDPR compliance, and French HDS certification." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk133> a prov:Entity ;
        ex:hasText "The project has a global budget of €900,000 over 5 years, with annual operating costs that must remain controlled and compatible with the authority's budgetary capacity." ;
