<http://example.org/extraction/tri/extraction158> {
    tri:tri187 a ex:Triplet ;
        ns1:affiliation <http://example.org/node/our> ;
        rdf:subject <http://example.org/node/our_csr_sustainability_officer> .

    tri:tri188 a ex:Triplet ;
        ns1:commitment <http://example.org/node/sustainability> ;
        rdf:subject <http://example.org/node/our> .
}

<http://example.org/extraction/con/extraction78> {
    con:con50 a ex:Constraint ;
        ns1:must_guarantee <http://example.org/node/a_response_time_below_2_0_seconds_for_common_queries> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/system> .
}

<http://example.org/extraction/tri/extraction159> {
    tri:tri189 a ex:Triplet ;
        ns1:has_ecovadis_rating <http://example.org/node/ecovadis_silver> ;
        rdf:subject <http://example.org/node/our> .

    tri:tri190 a ex:Triplet ;
        ns1:publishes <http://example.org/node/csr_statement> ;
        rdf:subject <http://example.org/node/our> .
}

<http://example.org/extraction/req/extraction15> {
    req:req38 a ex:Requirement ;
        ns1:must_support <http://example.org/node/medical_coding_pmsi_icd_10_for_activity_reporting_t2a> ;
        ex:category ex:information_extraction ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/solution> .
}

