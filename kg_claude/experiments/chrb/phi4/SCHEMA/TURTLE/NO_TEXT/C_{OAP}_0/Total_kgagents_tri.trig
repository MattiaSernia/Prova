    <http://example.org/node/chunk180> a prov:Entity ;
        ex:hasText "Our consortium proposes a solution that meets the requirements outlined in the call for tenders." ;
        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk181> a prov:Entity ;
        ex:hasText "Our consortium AI solution will provide hospital staff with an intelligent assistance tool, accessible from hospital staff work environment, capable of supporting hospital staff in hospital staff clinical and administrative activities." ;
