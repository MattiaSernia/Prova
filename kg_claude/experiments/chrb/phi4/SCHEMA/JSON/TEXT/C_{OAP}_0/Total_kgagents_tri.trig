        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk136> a prov:Entity ;
        ex:hasText "The solution is designed to ensure strict compliance with the relevant EU regulations, including GDPR and the EU AI Act." ;
