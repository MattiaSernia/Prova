    <http://example.org/node/chunk132> a prov:Entity ;
        ex:hasText "By leveraging these existing capabilities and certifications, we can implement the necessary security controls to comply with the tender's requirements." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk133> a prov:Entity ;
        ex:hasText "The tender requires strict GDPR compliance, compliance with regulatory requirements, and adherence to health-data hosting (HDS) regulations." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk134> a prov:Entity ;
        ex:hasText "The solution must be designed as an assistance tool, and no clinical or medico-administrative decision may be automated without explicit validation by a qualified professional." ;
