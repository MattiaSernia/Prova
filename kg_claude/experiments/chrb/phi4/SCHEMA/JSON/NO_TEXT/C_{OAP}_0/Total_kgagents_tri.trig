    <http://example.org/node/chunk98> a prov:Entity ;
        ex:hasText "One opportunity is that our company's flagship product, Atelier, can be adapted to provide AI assistance to hospital staff, supporting hospital staff clinical and administrative activities. our company's past references in the public sector, such as with a regional council and a mutual health insurer, demonstrate our company's ability to deliver similar solutions." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk99> a prov:Entity ;
