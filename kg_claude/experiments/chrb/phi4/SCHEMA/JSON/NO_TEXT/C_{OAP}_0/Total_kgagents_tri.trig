        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk98> a prov:Entity ;
        ex:hasText "The client requirements can be addressed as follows: 1." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk99> a prov:Entity ;
        ex:hasText "Response time below 2 seconds: FULLY COVERED Our platform Atelier has a median latency of 1.3 seconds and common queries have a p95 latency below 2 seconds. 2. 24/7 availability: FULLY COVERED our offer 24/7 operation on the appropriate hosting tier, with an availability target of 99.9%. 3." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

