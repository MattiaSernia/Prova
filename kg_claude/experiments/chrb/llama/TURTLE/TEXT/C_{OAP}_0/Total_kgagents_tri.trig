        prov:wasDerivedFrom <http://example.org/node/message15> .

    <http://example.org/node/chunk152> a prov:Entity ;
        ex:hasText "Our company, Faber IA also practice digital sobriety through model right-sizing, caching, and batching, which helps reduce energy consumption." ;
        prov:wasDerivedFrom <http://example.org/node/message15> .

    <http://example.org/node/chunk153> a prov:Entity ;
        ex:hasText "However, one known CSR tension Our company, Faber IA have is the trade-off between high availability and energy consumption." ;
        prov:wasDerivedFrom <http://example.org/node/message15> .

    <http://example.org/node/chunk154> a prov:Entity ;
        ex:hasText "Our company, Faber IA more energy-intensive premium high-availability configuration may be presented with Our more energy-intensive premium high-availability configuration associated footprint so that the client can make an informed decision about the trade-offs involved." ;
        prov:wasDerivedFrom <http://example.org/node/message15> .

    <http://example.org/node/chunk155> a prov:Entity ;
