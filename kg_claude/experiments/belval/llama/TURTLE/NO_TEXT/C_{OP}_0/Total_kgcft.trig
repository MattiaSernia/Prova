    <http://example.org/node/chunk104> a prov:Entity ;
        ex:hasText "The tender requires strict compliance to the General Regulation on the Protection of Data (GDPR) (con:con16), regulatory requirements in force (con:con17, con:con43), and a level of security (con:con45)." ;
        prov:wasDerivedFrom <http://example.org/node/message8> .

    <http://example.org/node/chunk105> a prov:Entity ;
        ex:hasText "The solution must ensure sovereignty of the data (con:con31), hosting exclusively on the territory of the European Union (con:con18), and no transfer of data outside the European Union (con:con19)." ;
        prov:wasDerivedFrom <http://example.org/node/message8> .

    <http://example.org/node/chunk106> a prov:Entity ;
        ex:hasText "What legal risks should we flag, and are we compliant? we have a Data Protection Officer appointed and we standard data residency is the European Union only. we also have a cross-border transfer policy that prohibits transfers by default unless there's an explicit legal basis." ;
        prov:wasDerivedFrom <http://example.org/node/message8> .

    <http://example.org/node/chunk107> a prov:Entity ;
        ex:hasText "This suggests compliance with the requirements for sovereignty of the data, hosting within the European Union, and not transferring data outside the European Union." ;
        prov:wasDerivedFrom <http://example.org/node/message8> .

    <http://example.org/node/chunk108> a prov:Entity ;
        ex:hasText "However, we should flag the risk related to open API integration, as the risk related to open API integration may require additional firewall rule hardening and privilege escalation audit to ensure compliance with the General Regulation on the Protection of Data (GDPR) (con:con16) and other regulatory requirements." ;
        prov:wasDerivedFrom <http://example.org/node/message8> .

    <http://example.org/node/chunk109> a prov:Entity ;
        ex:hasText "Additionally, we LDAP/AD integration must be reviewed for lateral movement risks to mitigate potential non-compliance issues." ;
        prov:wasDerivedFrom <http://example.org/node/message8> .

    <http://example.org/node/chunk11> a prov:Entity ;
        ex:hasText "Regulatory and legal constraints The expected solution will have to imperatively respect the regulatory requirements in force. 4.1 Protection of data The holder will have to guarantee a strict compliance to the General Regulation on the Protection of Data (GDPR)." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk110> a prov:Entity ;
        ex:hasText "Given we experience with RGPD/GDPR, EU AI Act, and other relevant frameworks, and considering we ISO 27001 certification which includes the design, development, and operation of AI-powered information systems within ISO 27001 scope, we appear to be generally compliant with the specified requirements." ;
        prov:wasDerivedFrom <http://example.org/node/message8> .

    <http://example.org/node/chunk111> a prov:Entity ;
        ex:hasText "Nonetheless, a thorough review of we specific implementation against each regulatory requirement is necessary to confirm full compliance." ;
        prov:wasDerivedFrom <http://example.org/node/message8> .

    <http://example.org/node/chunk112> a prov:Entity ;
        ex:hasText "The tender requires compliance with regulatory requirements in force (con:con17, con:con43), environmental issues to be taken into account (con:con44), and a level of security (con:con45)." ;
        prov:wasDerivedFrom <http://example.org/node/message10> .

    <http://example.org/node/chunk113> a prov:Entity ;
        ex:hasText "The client grants particular importance to sovereignty of the data (con:con31) and wishes to limit environmental footprint (con:con37)." ;
        prov:wasDerivedFrom <http://example.org/node/message10> .

    <http://example.org/node/chunk114> a prov:Entity ;
        ex:hasText "What legal risks should we flag, and are we compliant?" ;
