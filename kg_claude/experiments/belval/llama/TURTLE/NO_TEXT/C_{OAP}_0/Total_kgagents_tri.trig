    <http://example.org/node/chunk96> a prov:Entity ;
        ex:hasText "In terms of insurance and liability, we have a limitation of liability set at 3 million euros, professional indemnity insurance worth 5 million euros, and cyber liability coverage of 2 million euros, provided by AXA XL." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk97> a prov:Entity ;
        ex:hasText "This comprehensive insurance portfolio helps mitigate regulatory risks associated with the delivery of we solution. we standard contractual clauses include an SLA penalty mechanism, termination for cause and convenience notices, data return and destruction provisions upon termination, and a price revision mechanism based on annual indexation capped at the official national index." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk98> a prov:Entity ;
