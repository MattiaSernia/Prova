    <http://example.org/node/chunk76> a prov:Entity ;
        ex:hasText "However, the overhead cost of using SecNumCloud, which is 15% (architecture_constraints_known) is a necessary consideration to ensure sovereignty and compliance with regulatory requirements." ;
