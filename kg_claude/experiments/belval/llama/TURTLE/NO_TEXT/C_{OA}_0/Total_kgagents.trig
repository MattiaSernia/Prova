    <http://example.org/node/chunk65> a prov:Entity ;
        ex:hasText "To improve efficiency of administrative services (req2) and quality of service rendered to users (req3), Nexus Engineering will apply Nexus Engineering project management methodologies, such as PRINCE2, Agile Scrum, or SAFe, ensuring a structured approach to delivering the project." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk66> a prov:Entity ;
        ex:hasText "Nexus Engineering dedicated change manager and training delivery capabilities will facilitate the accompaniment of agents in agents administrative activities, addressing constraint con2 and ensuring a smooth transition." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk67> a prov:Entity ;
        ex:hasText "For decision traceability and detecting potential contradictions, Nexus Engineering maintain a risk register (risk_register_maintained) and conduct bi-weekly risk reviews (risk_review_frequency)." ;
