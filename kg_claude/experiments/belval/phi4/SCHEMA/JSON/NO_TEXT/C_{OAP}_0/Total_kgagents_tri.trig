        rdf:subject <http://example.org/node/agents> .

    req:req12 a ex:Requirement ;
        ns1:must_enable <http://example.org/node/search_for_information_in_the_internal_procedures_and_the_applicable_regulation_help_with_the_drafting_of_letters_or_of_answers_to_the_users_accompaniment_in_the_instruction_of_files_town_planning_social_aids_civil_status_etc_suggestion_of_actions_or_of_steps_to_realize_in_the_framework_of_an_administrative_process> ;
