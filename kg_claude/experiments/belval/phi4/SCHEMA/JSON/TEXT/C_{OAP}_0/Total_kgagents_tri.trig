    <http://example.org/node/chunk104> a prov:Entity ;
        ex:hasText "The global budget for the project is 3,000,000 euros over 4 years, with an emphasis on optimizing costs while guaranteeing service quality." ;
        prov:wasDerivedFrom <http://example.org/node/message11> .

    <http://example.org/node/chunk105> a prov:Entity ;
