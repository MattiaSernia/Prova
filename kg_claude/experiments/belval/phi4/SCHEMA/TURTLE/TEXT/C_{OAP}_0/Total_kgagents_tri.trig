        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk94> a prov:Entity ;
        ex:hasText "The client requires compliance with regulatory requirements, including GDPR, and adherence to sovereignty constraints, such as hosting on SecNumCloud-type infrastructure or equivalent." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk95> a prov:Entity ;
        ex:hasText "The solution must also be designed as a tool of assistance, with no automated decisions without explicit validation by an authorized professional." ;
