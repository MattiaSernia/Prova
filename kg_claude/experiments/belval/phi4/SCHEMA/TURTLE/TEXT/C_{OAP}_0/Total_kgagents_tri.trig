        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk148> a prov:Entity ;
        ex:hasText "Nexus Engineering S.r.l. proposed architecture leverages AI/ML systems, cloud architecture, API integration, data engineering, and cybersecurity to design a solution that meets the City of Belval's requirements." ;
        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk149> a prov:Entity ;
