        prov:wasDerivedFrom <http://example.org/node/message11> .

    <http://example.org/node/chunk97> a prov:Entity ;
        ex:hasText "Given our pricing model and current financial position, what is our projected margin on this project, and are there cost-optimization strategies our can propose while ensuring compliance with budgetary constraints?" ;
