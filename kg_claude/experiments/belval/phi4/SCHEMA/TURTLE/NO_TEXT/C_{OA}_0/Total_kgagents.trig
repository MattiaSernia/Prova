    <http://example.org/node/chunk139> a prov:Entity ;
        ex:hasText "Firstly, our company's has already conducted a bilan carbone in 2023, which provides a baseline for our company's total scope 1 and 2 greenhouse gas emissions at 148 tCO2e. our company's aim to achieve net zero by 2040." ;
        prov:wasDerivedFrom <http://example.org/node/message15> .

    <http://example.org/node/chunk14> a prov:Entity ;
