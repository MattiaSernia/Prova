    <http://example.org/node/chunk141> a prov:Entity ;
        ex:hasText "Our team is committed to delivering a high-quality solution that meets the City of Belval requirements and improves the efficiency of the City of Belval administrative services." ;
        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk142> a prov:Entity ;
        ex:hasText "Our believe that a comprehensive solution to implement an artificial intelligence (AI) system of assistance to the municipal agents of the City of Belval, combined with Our expertise in AI, project management, and technical architecture, makes Our an ideal partner for implement." ;
