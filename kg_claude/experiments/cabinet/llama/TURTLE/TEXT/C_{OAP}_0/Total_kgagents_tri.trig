    <http://example.org/node/chunk148> a prov:Entity ;
        ex:hasText "By taking these steps, our company's can effectively manage potential legal risks and demonstrate our company's capability to comply with the client stringent requirements regarding data protection, professional secrecy, and regulatory compliance." ;
        prov:wasDerivedFrom <http://example.org/node/message10> .

