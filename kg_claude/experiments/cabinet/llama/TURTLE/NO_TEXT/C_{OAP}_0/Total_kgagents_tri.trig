        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk117> a prov:Entity ;
        ex:hasText "The use of permissive licenses for open-source components and the provision of a Software Bill of Materials (SBOM) to the client add transparency and help mitigate potential intellectual property risks." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk118> a prov:Entity ;
        ex:hasText "By emphasizing we experience in maintaining professional secrecy, we compliance with GDPR through appropriate data processing practices, and we ability to provide audit trails and explanations for we solution's outputs, we can address the client's requirements and mitigate the identified legal risks." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

