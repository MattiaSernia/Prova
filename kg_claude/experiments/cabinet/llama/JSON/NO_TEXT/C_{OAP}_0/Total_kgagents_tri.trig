<http://example.org/extraction/req/extraction5> {
    req:req10 a ex:Requirement ;
        ns1:retrieve <http://example.org/node/regulatory_and_methodological_information> ;
        ex:category ex:information_management ;
        ex:priority ex:may ;
        rdf:subject <http://example.org/node/the_firm_s_professionals> .

    req:req11 a ex:Requirement ;
        ns1:assist_in_drafting <http://example.org/node/professional_documents> ;
        ex:category ex:document_management ;
        ex:priority ex:may ;
        rdf:subject <http://example.org/node/the_firm_s_professionals> .

    req:req12 a ex:Requirement ;
        ns1:handle <http://example.org/node/client_files> ;
        ex:category ex:client_management ;
        ex:priority ex:may ;
        rdf:subject <http://example.org/node/the_firm_s_professionals> .

    req:req13 a ex:Requirement ;
        ns1:ensure_continuity_of <http://example.org/node/missions> ;
        ex:category ex:team_collaboration ;
        ex:priority ex:may ;
        rdf:subject <http://example.org/node/collaborators> .

    req:req8 a ex:Requirement ;
        ns1:provide <http://example.org/node/an_intelligent_assistance_tool> ;
        ex:category ex:professional_services ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/the_firm_s_professionals> .

    req:req9 a ex:Requirement ;
        ns1:support <http://example.org/node/daily_activities> ;
        ex:category ex:professional_services ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/the_firm_s_professionals> .
}

<http://example.org/extraction/pro/extraction165> {
    pro:pro39 a ex:Proposal ;
        ns1:offers <http://example.org/node/a_licensing_model_that_allows_for_subscription_usage> ;
        rdf:subject <http://example.org/node/nexus_engineering> .
}

<http://example.org/extraction/pro/extraction154> {
    pro:pro11 a ex:Proposal ;
        ns1:flags <http://example.org/node/potential_anomalies_for_human_review> ;
        rdf:subject <http://example.org/node/the_platform> .

    pro:pro12 a ex:Proposal ;
        ns1:ensures <http://example.org/node/explainability> ;
        rdf:subject <http://example.org/node/the_platform> .
}

