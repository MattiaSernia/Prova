        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk81> a prov:Entity ;
        ex:hasText "The client requires a solution that improves productivity, quality, and reliability of work while preserving professional secrecy and reliability of figures." ;
