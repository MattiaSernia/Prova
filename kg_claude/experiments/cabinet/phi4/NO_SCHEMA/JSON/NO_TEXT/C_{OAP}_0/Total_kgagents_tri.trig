    <http://example.org/node/chunk88> a prov:Entity ;
        ex:hasText "Complying with regulatory professional and legal constraints is a key aspect of our flagship product, Atelier, which is a sovereign platform that forges document-grounded AI assistants from an organization's own documents solution." ;
        prov:wasDerivedFrom <http://example.org/node/message4> .

    <http://example.org/node/chunk89> a prov:Entity ;
        ex:hasText "As a French company, our company's are well-versed in European regulations, including GDPR, and our company's SecNumCloud-qualified infrastructure partner, OuraneCloud, ensures that data hosting meets the required standards." ;
        prov:wasDerivedFrom <http://example.org/node/message4> .

    <http://example.org/node/chunk9> a prov:Entity ;
        ex:hasText "Quick access to reliable, up-to-date information drawn from accounting standards (PCG), tax doctrine and the tax code (CGI), the commercial code and applicable legal texts, collective-bargaining agreements for payroll/social, and Cabinet Vauclair & Associés internal procedures and methodology guides." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk90> a prov:Entity ;
        ex:hasText "Controlling annual operating costs is also a consideration." ;
        prov:wasDerivedFrom <http://example.org/node/message4> .

    <http://example.org/node/chunk91> a prov:Entity ;
