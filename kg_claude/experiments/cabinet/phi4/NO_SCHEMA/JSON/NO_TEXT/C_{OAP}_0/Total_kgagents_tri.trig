        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk120> a prov:Entity ;
        ex:hasText "Additionally, we ISO 27701 certification provides a privacy information management extension, demonstrating we ability to manage personal data in accordance with GDPR principles." ;
