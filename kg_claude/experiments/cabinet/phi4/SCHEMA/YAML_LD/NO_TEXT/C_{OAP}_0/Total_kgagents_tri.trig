    <http://example.org/node/chunk1> a prov:Entity ;
        ex:hasText "1." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk10> a prov:Entity ;
        ex:hasText "Answers must be contextualised and grounded in cited sources.  3.2 Drafting assistance." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk100> a prov:Entity ;
        ex:hasText "Faber IA have connectors and adapters for these types of systems, including accounting-production and payroll software, document-management systems, and electronic-invoicing/dematerialisation environments." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk101> a prov:Entity ;
        ex:hasText "To ensure security and compliance with GDPR regulations, Our Atelier platform provides strict access control, which can be strictly partitioned and audited per client file." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk102> a prov:Entity ;
        ex:hasText "Additionally, Faber IA support single sign-on (SSO) using SAML and OIDC protocols, as well as user directories like LDAP and Entra ID, to guarantee the confidentiality and integrity of client data." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk103> a prov:Entity ;
        ex:hasText "Faber IA model-agnostic approach allows Faber IA to choose a suitable model that complies with the client's requirements." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk104> a prov:Entity ;
        ex:hasText "The Sovereign European open-weight model, hosted by Faber IA on OuraneCloud, ensures full sovereignty, auditability, and strong grounding/citation behavior, which is essential for compliance with regulatory requirements." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk105> a prov:Entity ;
        ex:hasText "By designing Faber IA technical architecture around these components and capabilities, Faber IA can fulfill the client's technical constraints while ensuring that the solution is scalable, secure, and compliant with all specified regulations." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk106> a prov:Entity ;
        ex:hasText "Given the security and compliance requirements such as protecting sensitive data through encryption and pseudonymisation where relevant (req:req53), complying with GDPR for personal data protection (con:con35, con:con36), ensuring complete audit trails and explainability (con:con44), respecting auditor's independence and separation of duties (con:con49), and adhering to anti-money laundering obligations (con:con51) and legal retention and archival obligations for accounting documents (con:con52), how can we ensure we solution meets these security and compliance standards, particularly in relation to data sovereignty (req:req101) and the confidentiality of client data (con:con32)? we has ISO 27001 certification since 2023, which covers the development, delivery, and operations of we services." ;
