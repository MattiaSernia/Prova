        prov:wasDerivedFrom <http://example.org/node/message15> .

    <http://example.org/node/chunk156> a prov:Entity ;
        ex:hasText "Cabinet Vauclair Associés apprenticeship and work-study program, as well as Cabinet Vauclair Associés research partnership with the Grenoble research ecosystem, showcase Cabinet Vauclair Associés dedication to social commitments." ;
        prov:wasDerivedFrom <http://example.org/node/message15> .

