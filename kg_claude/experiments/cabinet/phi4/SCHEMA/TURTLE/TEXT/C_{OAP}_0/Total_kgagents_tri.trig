    <http://example.org/node/chunk86> a prov:Entity ;
        ex:hasText "Faber IA will also ensure compliance with regulatory constraints such as GDPR, professional secrecy, and anti-money laundering obligations (LCB-FT) by implementing appropriate measures like encryption, pseudonymization, and access controls." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk87> a prov:Entity ;
