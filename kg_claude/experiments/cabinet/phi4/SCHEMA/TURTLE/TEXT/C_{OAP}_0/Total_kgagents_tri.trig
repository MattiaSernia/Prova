    <http://example.org/node/chunk81> a prov:Entity ;
        ex:hasText "Given the client's requirements for a regional accounting and statutory-audit firm (cabinet d’expertise comptable et de commissariat aux comptes) operating several offices across the Belval region with around 250 staff, under strict confidentiality obligations and strong seasonality of workload, how do we coordinate we consortium to meet these needs while ensuring compliance with regulatory constraints such as GDPR, professional secrecy, and anti-money laundering obligations (LCB-FT), and what are the key performance indicators for success?" ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk82> a prov:Entity ;
