<http://example.org/extraction/req/extraction4> {
    req:req10 a ex:Requirement ;
        ns1:must_equip <http://example.org/node/the_firm_s_professionals> ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/cabinet_vauclair_associ_s> .

    req:req11 a ex:Requirement ;
        ns1:must_improve <http://example.org/node/productivity_and_the_quality_and_reliability_of_the_firm_s_professionals_work> ;
        ex:category ex:staff_assistance ;
        ex:priority ex:must ;
