    <http://example.org/node/chunk1> a prov:Entity ;
        ex:hasText "1." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk10> a prov:Entity ;
        ex:hasText "Answers must be contextualised and grounded in cited sources.  3.2 Drafting assistance." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk100> a prov:Entity ;
        ex:hasText "Integration with accounting production software, payroll software, document management (GED): FULLY COVERED our have connectors and adapters for accounting production software, payroll software, document management (GED, enabling integration through our business tool integration capabilities." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk101> a prov:Entity ;
        ex:hasText "Integration with electronic invoicing dematerialisation environment: FULLY COVERED The solution can integrate with electronic invoicing dematerialisation environment, as integrate is part of our business tool integration capabilities." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk102> a prov:Entity ;
        ex:hasText "API-type interfaces: FULLY COVERED The solution provides API-first design (REST + webhook) and documented APIs, allowing for easy embedding in existing work environments." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk103> a prov:Entity ;
        ex:hasText "Integration with user directory SSO: FULLY COVERED our support single sign-on (SSO) through SAML, OIDC, and integration with user directories like LDAP and Entra ID." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk104> a prov:Entity ;
        ex:hasText "Proposed architecture: our Atelier platform, a Retrieval-augmented generation (RAG) platform, will be used as the foundation for the solution." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk105> a prov:Entity ;
        ex:hasText "Our Atelier platform, a Retrieval-augmented generation (RAG) platform will be hosted on OuraneCloud, which provides SecNumCloud-qualified infrastructure." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk106> a prov:Entity ;
        ex:hasText "Our Atelier platform, a Retrieval-augmented generation (RAG) platform components, including the document-ingestion pipeline, vector store, retrieval layer, orchestration layer, and answer layer, will work together to provide the required functionality." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk107> a prov:Entity ;
        ex:hasText "To meet the client's requirements, our will leverage our existing connectors and adapters for accounting production software, payroll software, document management (GED), and electronic invoicing dematerialisation environment. our will also utilize our API-first design to provide API-type interfaces and integrate with the user directory SSO." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk108> a prov:Entity ;
        ex:hasText "Additionally, our will ensure that The solution is properly sized to handle seasonal peak loads and provide high availability during business hours. our active-active redundancy across two availability zones will guarantee resilience and performance." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk109> a prov:Entity ;
        ex:hasText "By leveraging our existing technology stack and architecture, our can provide a comprehensive solution that meets the client's requirements while minimizing the need for custom development or additional infrastructure." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk11> a prov:Entity ;
        ex:hasText "Assistance in drafting client letters and correspondence, mission notes, file memos and syntheses." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk110> a prov:Entity ;
        ex:hasText "The tender requires strict GDPR compliance (EU-only data hosting, no transfer outside EU, encryption and pseudonymisation of sensitive data where applicable)." ;
