    <http://example.org/node/chunk1> a prov:Entity ;
        ex:hasText "1." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk10> a prov:Entity ;
        ex:hasText "Answers must be contextualised and grounded in cited sources.  3.2 Drafting assistance." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk100> a prov:Entity ;
        ex:hasText "No decision may be automated without explicit validation by an authorised professional." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk101> a prov:Entity ;
        ex:hasText "What security risks should we flag, and are we compliant with the regulatory constraints, including GDPR, anti-money laundering regulations, and legal retention and archival obligations for accounting documents?" ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk102> a prov:Entity ;
        ex:hasText "Based on we company context at Faber IA, we have certifications such as ISO 27001 and ISO 27701 which demonstrate we commitment to information security and privacy. we hosting partner, OuraneCloud, provides a SecNumCloud-qualified infrastructure that supports sovereign hosting of confidential data within EU. provides addresses the requirement for EU-only data hosting and no transfer outside EU. we data protection measures include encryption in transit using TLS 1.3, encryption at rest using AES-256, and key management on an EU-based infrastructure. we also employ strict partitioning with logical isolation per client and per mission, as well as access controls to prevent cross-client circulation of data." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk103> a prov:Entity ;
        ex:hasText "Pseudonymisation is also used where relevant." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk104> a prov:Entity ;
        ex:hasText "Regarding professional secrecy and confidentiality of client data, we experience in delivering solutions to clients bound by professional secrecy, including a national professional order, ensures we are familiar with the requirements for maintaining confidentiality." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk105> a prov:Entity ;
