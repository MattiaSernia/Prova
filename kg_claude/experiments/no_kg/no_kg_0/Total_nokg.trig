    <http://example.org/node/chunk166> a prov:Entity ;
        ex:hasText "The AIInnovation Agent proposes a RAG system for accurate information retrieval, fine-tuning of the LLM on a domain-specific corpus to adapt to municipal agent needs, and implementation of explainability methods to ensure transparency." ;
        prov:wasDerivedFrom <http://example.org/node/message14> .

    <http://example.org/node/chunk167> a prov:Entity ;
