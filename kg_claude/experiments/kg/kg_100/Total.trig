<http://example.org/extraction/tri/extraction8> {
    tri:tri76 a ex:Triplet ;
        ns1:has_environmental_goal <http://example.org/node/reduce_footprint> ;
        rdf:subject <http://example.org/node/the_city_of_belval> .

    tri:tri77 a ex:Triplet ;
        ns1:uses_renewable_energy_percentage <http://example.org/node/100> ;
        rdf:subject <http://example.org/node/ovhcloud> .

    tri:tri78 a ex:Triplet ;
        ns1:uses_renewable_energy_percentage <http://example.org/node/100> ;
        rdf:subject <http://example.org/node/scaleway> .

    tri:tri79 a ex:Triplet ;
        ns1:has_pue_rating <http://example.org/node/1_3> ;
        rdf:subject <http://example.org/node/ovhcloud> .

