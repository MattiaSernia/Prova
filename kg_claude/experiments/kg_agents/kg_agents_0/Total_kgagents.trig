    <http://example.org/node/chunk63> a prov:Entity ;
        ex:hasText "Given The City of Belval goals of improving administrative efficiency and quality of service, and we expertise in digital transformation, AI solutions, and public sector IT, the following KPIs are suggested:  1." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

