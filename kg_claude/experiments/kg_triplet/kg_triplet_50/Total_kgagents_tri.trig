<http://example.org/extraction/con/extraction3> {
    con:con1 a ex:Constraint ;
        ns1:will_have_to_be_hosted_exclusively_on <http://example.org/node/the_territory_of_the_european_union> ;
        ex:constraintType ex:regulatory ;
        rdf:subject <http://example.org/node/data> .

    con:con2 a ex:Constraint ;
        ns1:will_not_be_authorized_outside <http://example.org/node/the_european_union> ;
        ex:constraintType ex:regulatory ;
        rdf:subject <http://example.org/node/data_transfer> .

    con:con3 a ex:Constraint ;
        ns1:will_have_to_be_protected_in_an_appropriate_manner_using <http://example.org/node/encryption_anonymization_if_necessary> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/data> .

    con:con4 a ex:Constraint ;
        ns1:must_guarantee_strict_compliance_with <http://example.org/node/general_regulation_on_the_protection_of_data_gdpr> ;
        ex:constraintType ex:regulatory ;
        rdf:subject <http://example.org/node/solution> .

    con:con5 a ex:Constraint ;
        ns1:must_be_able_to_be_explained_and_understood_a_posteriori <http://example.org/node/elements_having_led_to_an_answer_or_suggestion> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/recommendations_or_proposals_issued_by_the_solution> .

    con:con6 a ex:Constraint ;
        ns1:will_not_allow_automated_decisions_without <http://example.org/node/explicit_validation_of_an_agent> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/decision_making_process> .

    con:con7 a ex:Constraint ;
        ns1:will_have_to_provide_response_times <http://example.org/node/compatible_with_daily_use_by_agents> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/solution> .
}

<http://example.org/extraction/con/extraction4> {
