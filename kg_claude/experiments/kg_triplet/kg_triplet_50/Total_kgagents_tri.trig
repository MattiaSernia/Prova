        rdf:subject <http://example.org/node/time_of_response> .

    con:con9 a ex:Constraint ;
        ns1:is_expected_to_be <http://example.org/node/high_level_of_99_9> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/availability> .
}

