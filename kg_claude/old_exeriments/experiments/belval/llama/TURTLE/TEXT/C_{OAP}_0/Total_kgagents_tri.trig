    pro:pro5 a ex:Proposal ;
        ns1:will_assist_with <http://example.org/node/searching_for_information_in_internal_procedures_and_applicable_regulation_drafting_letters_or_answers_to_users_instructing_files_and_suggesting_actions_or_steps_to_realize_in_administrative_processes> ;
        rdf:subject <http://example.org/node/an_artificial_intelligence_solution> .
}

