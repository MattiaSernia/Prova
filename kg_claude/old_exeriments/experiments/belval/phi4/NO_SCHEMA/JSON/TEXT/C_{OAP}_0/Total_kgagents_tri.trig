    <http://example.org/node/chunk45> a prov:Entity ;
        ex:hasText "To indicative title, a time of response lower than 2 seconds is expected for the current requests." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk46> a prov:Entity ;
        ex:hasText "A high level of relevance of the answers is expected. 5.2 Availability The expected solution will have to guarantee a high level of availability, compatible with the needs of the municipal services." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk47> a prov:Entity ;
        ex:hasText "An objective of availability of the order of 99.9% is expected. 5.3 Integration The expected solution will have to integrate The expected solution with the existing system of information, notably: the business softwares (civil status, town planning), the electronic management of documents (EDM), the user directories." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk48> a prov:Entity ;
        ex:hasText "Interfaces of API type will be expected. 6." ;
