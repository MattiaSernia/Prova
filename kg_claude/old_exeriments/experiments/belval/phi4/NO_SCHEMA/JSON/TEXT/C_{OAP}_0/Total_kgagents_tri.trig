    <http://example.org/node/chunk91> a prov:Entity ;
        ex:hasText "As Legal Counsel for Nexus Engineering S.r.l., I have reviewed Nexus Engineering S.r.l. context and The City of Belval's call for tenders." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk92> a prov:Entity ;
        ex:hasText "The main legal risks associated with this project are related to data protection, intellectual property, and contractual compliance." ;
