    <http://example.org/node/chunk102> a prov:Entity ;
        ex:hasText "API integration with the hospital's existing information systems and user directories: our have API-first design with documented APIs, which can be embedded in existing work environments, and our support integration with user directories such as LDAP and Entra ID." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk103> a prov:Entity ;
        ex:hasText "Additionally, our health interoperability capabilities include support for standards like HL7 and FHIR." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

