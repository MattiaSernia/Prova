    <http://example.org/node/chunk145> a prov:Entity ;
        ex:hasText "Additionally, maintaining compliance with GDPR, HDS certification, and ensuring no data transfer outside the EU are crucial." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk146> a prov:Entity ;
        ex:hasText "While we have a foundation in regulatory compliance, particularly with GDPR, we should verify we HDS certification status and ensure that our specific solution design and deployment align with avoiding medical-device qualification requirements." ;
