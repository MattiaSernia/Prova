    req:req7 a ex:Requirement ;
        ns1:must_reduce <http://example.org/node/time_spent_on_administrative_tasks> ;
        ex:category ex:workload_management ;
        rdf:subject <http://example.org/node/staff> .

    req:req8 a ex:Requirement ;
        ns1:faced_with <http://example.org/node/a_growing_complexity_of_procedures_a_multiplicity_of_information_sources_care_protocols_recommendations_from_the_haute_autorit_de_sant_has_internal_procedures_regulatory_texts_business_systems_and_an_increasing_volume_of_administrative_and_documentation_work> ;
        ex:category ex:information_overload ;
        rdf:subject <http://example.org/node/staff> .
}

