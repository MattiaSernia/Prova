        rdf:subject <http://example.org/node/our_solution> .

    pro:pro20 a ex:Proposal ;
        ns1:includes <http://example.org/node/a_design_phase_2_weeks> ;
        rdf:subject <http://example.org/node/our_solution> .

    pro:pro21 a ex:Proposal ;
