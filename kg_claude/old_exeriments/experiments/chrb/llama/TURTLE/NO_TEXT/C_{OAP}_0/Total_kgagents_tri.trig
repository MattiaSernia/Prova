        rdf:subject <http://example.org/node/our_solution> .

    pro:pro22 a ex:Proposal ;
        ns1:includes <http://example.org/node/a_generalization_phase_6_months> ;
        rdf:subject <http://example.org/node/our_solution> .

    pro:pro23 a ex:Proposal ;
        ns1:includes <http://example.org/node/a_run_phase_2_years> ;
        rdf:subject <http://example.org/node/our_solution> .
}

