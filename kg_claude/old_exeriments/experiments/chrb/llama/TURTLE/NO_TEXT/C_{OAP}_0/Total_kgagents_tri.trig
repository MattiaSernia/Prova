<http://example.org/extraction/req/extraction36> {
    req:req59 a ex:Requirement ;
        ns1:support <http://example.org/node/health_interoperability_standards> ;
        ex:category ex:healthcare ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/healthcare_providers> .

    req:req60 a ex:Requirement ;
        ns1:access <http://example.org/node/national_health_identifier> ;
        ex:category ex:healthcare ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/patients> .

    req:req61 a ex:Requirement ;
        ns1:comply_with <http://example.org/node/national_framework> ;
        ex:category ex:healthcare ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/healthcare_system> .
}

<http://example.org/extraction/pro/extraction172> {
    pro:pro17 a ex:Proposal ;
        ns1:ensures <http://example.org/node/our_solution_meets_the_expected_quality_standards> ;
