<http://example.org/extraction/tri/extraction133> {
    tri:tri114 a ex:Triplet ;
        ns1:falls_within_the_scope_of <http://example.org/node/medical_device_regulations> ;
        rdf:subject <http://example.org/node/ai_assistance_solution> .

    tri:tri115 a ex:Triplet ;
        ns1:is_crucial_for <http://example.org/node/determining_whether_the_ai_assistance_solution_falls_within_the_scope_of_medical_device_regulations> ;
        rdf:subject <http://example.org/node/assessment> .
}

<http://example.org/extraction/tri/extraction118> {
    tri:tri65 a ex:Triplet ;
        ns1:can_protect <http://example.org/node/sensitive_health_data> ;
        rdf:subject <http://example.org/node/aes_256> .

    tri:tri66 a ex:Triplet ;
        ns1:using <http://example.org/node/tls_1_3> ;
        rdf:subject <http://example.org/node/encryption_in_transit> .

    tri:tri67 a ex:Triplet ;
        ns1:using <http://example.org/node/aes_256> ;
        rdf:subject <http://example.org/node/encryption_at_rest> .
}

<http://example.org/extraction/req/extraction30> {
    req:req58 a ex:Requirement ;
        ns1:must_provide <http://example.org/node/response_times_compatible_with_daily_clinical_use> ;
        ex:category ex:healthcare ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/solution> .
}

