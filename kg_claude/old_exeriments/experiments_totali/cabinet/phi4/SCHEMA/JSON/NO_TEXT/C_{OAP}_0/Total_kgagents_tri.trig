<http://example.org/extraction/tri/extraction120> {
    tri:tri114 a ex:Triplet ;
        ns1:has <http://example.org/node/legalagent> ;
        rdf:subject <http://example.org/node/faber_ia> .

    tri:tri115 a ex:Triplet ;
        ns1:complies_with <http://example.org/node/social_and_fiscal_obligations> ;
        rdf:subject <http://example.org/node/faber_ia> .

    tri:tri116 a ex:Triplet ;
        ns1:has <http://example.org/node/administrativeattestation> ;
        rdf:subject <http://example.org/node/faber_ia> .
}

<http://example.org/extraction/con/extraction41> {
    con:con1 a ex:Constraint ;
        ns1:must_comply_with <http://example.org/node/regulatory_requirements> ;
        ex:constraintType ex:regulatory ;
        rdf:subject <http://example.org/node/solution> .

    con:con2 a ex:Constraint ;
        ns1:must_integrate_with <http://example.org/node/existing_infrastructure> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/system> .
}

<http://example.org/extraction/tri/extraction112> {
    tri:tri100 a ex:Triplet ;
        ns1:respects <http://example.org/node/separation_of_duties> ;
        rdf:subject <http://example.org/node/faber_ia> .

    tri:tri101 a ex:Triplet ;
        ns1:provides <http://example.org/node/non_decisional_support_tool> ;
        rdf:subject <http://example.org/node/faber_ia> .

    tri:tri102 a ex:Triplet ;
        ns1:complies_with <http://example.org/node/the_solution_must_not_automate_decisions_without_explicit_validation_by_an_authorised_professional> ;
        rdf:subject <http://example.org/node/faber_ia> .

    tri:tri103 a ex:Triplet ;
        ns1:complies_with <http://example.org/node/explainable_ai_outputs_that_are_auditable> ;
        rdf:subject <http://example.org/node/faber_ia> .

    tri:tri99 a ex:Triplet ;
        ns1:understands <http://example.org/node/anti_money_laundering_obligations_lcb_ft> ;
        rdf:subject <http://example.org/node/faber_ia> .
}

<http://example.org/extraction/tri/extraction111> {
    tri:tri95 a ex:Triplet ;
        ns1:provides <http://example.org/node/atelier> ;
        rdf:subject <http://example.org/node/faber_i_a> .

    tri:tri96 a ex:Triplet ;
        ns1:provides <http://example.org/node/retrieval_trace_audit_log_and_figure_source_linking> ;
        rdf:subject <http://example.org/node/atelier> .

    tri:tri97 a ex:Triplet ;
        ns1:has_certification <http://example.org/node/explainability_and_auditability> ;
        rdf:subject <http://example.org/node/faber_i_a> .

    tri:tri98 a ex:Triplet ;
        ns1:applies <http://example.org/node/pseudonymisation> ;
        rdf:subject <http://example.org/node/faber_i_a> .
}

<http://example.org/extraction/tri/extraction89> {
    tri:tri33 a ex:Triplet ;
        ns1:requires <http://example.org/node/response_time_below_2_seconds_high_availability_during_business_hours_with_resilience_to_seasonal_peak_loads_api_integration_with_the_client_existing_information_systems_and_user_directories_hosting_on_sovereign_infrastructure_certified_to_the_level_required_by_the_tender_within_the_eu_no_dependency_on_non_european_suppliers> ;
        rdf:subject <http://example.org/node/the_client> .
}

