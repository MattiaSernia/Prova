        ex:hasText "The client also requires compliance with anti-money laundering obligations (LCB-FT) and respect for auditor independence and separation of duties." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk119> a prov:Entity ;
        ex:hasText "What legal risks should we flag, and are we compliant?" ;
