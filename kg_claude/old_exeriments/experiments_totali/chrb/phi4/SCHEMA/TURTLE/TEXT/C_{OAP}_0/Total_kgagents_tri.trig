    <http://example.org/node/chunk127> a prov:Entity ;
        ex:hasText "Faber IA also utilize sovereign European open-weight models under sovereign European open-weight models respective licenses." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk128> a prov:Entity ;
        ex:hasText "To ensure our proposal complies with relevant regulatory frameworks, including GDPR, EU AI Act, and specific healthcare regulations, we should: 1." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk129> a prov:Entity ;
        ex:hasText "Emphasize that our company's Atelier platform is designed as a non-decisional support tool, providing assistance to qualified professionals without automating clinical or medico-administrative decisions. 2." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk13> a prov:Entity ;
        ex:hasText "Generated content must be adapted to the clinical/administrative context and conform to expected quality standards. 3.3 Dossier-handling assistance." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk130> a prov:Entity ;
        ex:hasText "Confirm that our proposal does not require medical-device qualification (CE marking/MDR), aligning with the call for tenders' stipulations. 3." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk131> a prov:Entity ;
        ex:hasText "Highlight Faber IA experience in maintaining regulatory compliance, particularly regarding GDPR, medical confidentiality, and HDS framework obligations, which are monitored by Faber IA Security & Compliance function. 4." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk132> a prov:Entity ;
        ex:hasText "Provide documentation on we professional liability insurance, which covers up to 10 million euros per claim, demonstrating Faber IA commitment to responsible business practices." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk133> a prov:Entity ;
        ex:hasText "By addressing these points, Faber IA can demonstrate Faber IA understanding of the regulatory landscape and mitigate potential legal risks associated with our proposal." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk134> a prov:Entity ;
        ex:hasText "The global budget for this project is €900,000 over 5 years, with a requirement for controlled annual operating costs compatible with the authority's budgetary capacity." ;
