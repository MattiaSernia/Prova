    <http://example.org/node/chunk97> a prov:Entity ;
        ex:hasText "Our company, Faber IA, have past references in the public sector, including a regional council and a mutual health insurer, which demonstrate Our company, Faber IA, ability to deliver AI assistance solutions that improve staff efficiency and patient care quality." ;
