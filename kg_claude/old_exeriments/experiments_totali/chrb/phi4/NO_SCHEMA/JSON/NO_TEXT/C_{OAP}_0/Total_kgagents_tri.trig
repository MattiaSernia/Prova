    <http://example.org/node/chunk157> a prov:Entity ;
        ex:hasText "What are our proposed AI components and innovation strategy for this tender response?" ;
        prov:wasDerivedFrom <http://example.org/node/message13> .

    <http://example.org/node/chunk158> a prov:Entity ;
        ex:hasText "Our company, Faber IA, proposes an AI assistance solution that leverages our retrieval-augmented generation capabilities to support hospital staff in hospital staff daily activities." ;
