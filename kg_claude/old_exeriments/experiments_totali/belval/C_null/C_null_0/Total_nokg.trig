    <http://example.org/node/chunk124> a prov:Entity ;
        ex:hasText "Furthermore, to ensure transparency and trust in the AI-driven decision-making process, we can implement explainability methods such as source citation (RAG grounding), chain-of-thought display, or confidence scoring." ;
        prov:wasDerivedFrom <http://example.org/node/message12> .

