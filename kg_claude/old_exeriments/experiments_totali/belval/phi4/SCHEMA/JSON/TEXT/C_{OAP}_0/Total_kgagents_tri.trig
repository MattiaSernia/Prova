        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk81> a prov:Entity ;
        ex:hasText "Nexus Engineering S.r.l. cross-border transfer policy prohibits transfers outside the EU by default unless there's an explicit legal basis." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk82> a prov:Entity ;
        ex:hasText "In terms of security controls, Nexus Engineering S.r.l. can implement measures like multi-factor authentication (MFA), which is already enforced in Nexus Engineering S.r.l. access control standards using methods such as TOTP and hardware tokens (FIDO2)." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk83> a prov:Entity ;
        ex:hasText "Nexus Engineering S.r.l. also have experience with Role-Based Access Control (RBAC) design and use Privileged Access Management (PAM) solutions like CyberArk Conjure and HashiCorp Vault." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk84> a prov:Entity ;
        ex:hasText "For data protection, Nexus Engineering S.r.l. can ensure that all queries are logged with immutability using SHA-256 hash chaining and retain audit logs for 7 years." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk85> a prov:Entity ;
        ex:hasText "Nexus Engineering S.r.l. incident response plan includes a Security Incident Response Team (SIRT) and playbooks to handle any potential breaches or security incidents." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk86> a prov:Entity ;
        ex:hasText "Given The City of Belval requirements, Nexus Engineering S.r.l. existing ISO 27001 certification, which covers the design, development, and operation of AI-powered information systems, demonstrates Nexus Engineering S.r.l. commitment to information security." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk87> a prov:Entity ;
        ex:hasText "Nexus Engineering S.r.l. also have experience with SecNumCloud projects, which is relevant for hosting sensitive data securely." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk88> a prov:Entity ;
        ex:hasText "To further guarantee compliance with the General Regulation on the Protection of Data (GDPR), Nexus Engineering S.r.l. can conduct Data Protection Impact Assessments (DPIAs) as needed, given that Nexus Engineering S.r.l. have the capability to do so." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk89> a prov:Entity ;
        ex:hasText "Nexus Engineering S.r.l. average DPIA duration is about 3 weeks, indicating Nexus Engineering S.r.l. efficiency in assessing and mitigating risks related to personal data processing." ;
