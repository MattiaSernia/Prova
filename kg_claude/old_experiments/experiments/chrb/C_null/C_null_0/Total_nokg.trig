@prefix con: <http://example.org/constraint/> .
@prefix ex: <http://example.org/ontologia#> .
@prefix ns1: <http://example.org/edge/> .
@prefix pro: <http://example.org/proposal/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix req: <http://example.org/requirement/> .
@prefix tri: <http://example.org/triplet/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extraction/con/extraction58> {
    con:con21 a ex:Constraint ;
        ns1:must_contextualise <http://example.org/node/the_solution_answers_to_the_staff_member_s_request_3_2_drafting_assistance> ;
        rdf:subject <http://example.org/node/solution> .
}

<http://example.org/extraction/con/extraction54> {
    con:con14 a ex:Constraint ;
        ns1:must_provide <http://example.org/node/hospital_staff_with_an_intelligent_assistance_tool_accessible_from_hospital_staff_work_environment_capable_of_supporting_hospital_staff_in_hospital_staff_clinical_administrative_activities> ;
        rdf:subject <http://example.org/node/solution> .

    con:con15 a ex:Constraint ;
        ns1:may_cover <http://example.org/node/retrieval_of_information_from_internal_procedures_care_protocols_and_applicable_regulation_assistance_in_drafting_medical_and_administrative_documents_support_in_handling_dossiers_admissions_coding_medico_social_pathways_etc_support_for_the_continuity_of_care_between_professionals_shifts_and_services> ;
        rdf:subject <http://example.org/node/intelligent_assistance_tool> .

    con:con16 a ex:Constraint ;
        ns1:must_be_accessible_from <http://example.org/node/hospital_staff_work_environment> ;
        rdf:subject <http://example.org/node/intelligent_assistance_tool> .
}

<http://example.org/extraction/req/extraction31> {
    req:req66 a ex:Requirement ;
        ns1:must_improve <http://example.org/node/response_time> ;
        ex:category ex:digital_transformation ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/system> .

    req:req67 a ex:Requirement ;
        ns1:must_provide <http://example.org/node/below_2_seconds> ;
        ex:category ex:performance ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/system> .
}

<http://example.org/extraction/con/extraction84> {
    con:con65 a ex:Constraint ;
        ns1:must_integrate_with <http://example.org/node/user_directories> ;
        rdf:subject <http://example.org/node/solution> .

    con:con66 a ex:Constraint ;
        ns1:must_be <http://example.org/node/api_type> ;
        rdf:subject <http://example.org/node/solution> .
}

<http://example.org/extraction/con/extraction85> {
    con:con67 a ex:Constraint ;
        ns1:sovereignty <http://example.org/node/authority> ;
        ex:constraintType ex:sovereignty ;
        rdf:subject <http://example.org/node/data> .

    con:con68 a ex:Constraint ;
        ns1:attaches_particular_importance_to <http://example.org/node/authority> ;
        rdf:subject <http://example.org/node/data_sovereignty> .
}

<http://example.org/extraction/req/extraction37> {
    req:req78 a ex:Requirement ;
        ns1:must_provide <http://example.org/node/api_type_interfaces> ;
        ex:category ex:information_extraction ;
        rdf:subject <http://example.org/node/system> .

    req:req79 a ex:Requirement ;
        ns1:must_integrate_with <http://example.org/node/user_directories> ;
        ex:category ex:information_extraction ;
        rdf:subject <http://example.org/node/system> .
}

